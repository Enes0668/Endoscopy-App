<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- GitHub Packages — private EndoCapture.Core paketi buradan indirilir -->
    <add key="github" value="https://nuget.pkg.github.com/Enes0668/index.json" />
    <!-- nuget.org — açık kaynak paketler -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="Enes0668" />
      <!-- GitHub PAT'ini buraya YAZMAyın — ortam değişkenini kullanın:
           NUGET_AUTH_TOKEN=<PAT> dotnet restore
           Ya da Visual Studio / Rider'ın kimlik bilgisi yöneticisine girin. -->
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
